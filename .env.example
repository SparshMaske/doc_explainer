# Ollama (OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Models per pipeline stage (provider defaults to "ollama")
SCOPING_MODEL=qwen3:14b
SCOPING_PROVIDER=ollama
ISSUE_TREE_MODEL=qwen3:14b
ISSUE_TREE_PROVIDER=ollama
RESEARCH_FAST_MODEL=qwen3:8b
RESEARCH_FAST_PROVIDER=ollama
RESEARCH_SMART_MODEL=qwen3:14b
RESEARCH_SMART_PROVIDER=ollama
VERIFY_MODEL=qwen3:14b
VERIFY_PROVIDER=ollama
SYNTHESIS_MODEL=qwen3:14b
SYNTHESIS_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=ollama

# Limits (16GB M2: keep one LLM call at a time)
MAX_CONTEXT=8192
MAX_CONCURRENCY=1

# Services and storage
SEARX_URL=http://localhost:8080
DATA_DIR=data
